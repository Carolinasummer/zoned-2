# Supabase — береш у Project Settings > API на supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API — береш у console.anthropic.com (Settings > API Keys)
# УВАГА: цей ключ НЕ повинен мати префікс NEXT_PUBLIC_ — інакше потрапить у браузер
ANTHROPIC_API_KEY=

# Telegram бот — береш у @BotFather в Telegram (тільки для Railway/бота, етап 9)
TELEGRAM_BOT_TOKEN=
